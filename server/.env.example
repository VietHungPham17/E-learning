# ── Stream Chat ───────────────────────────────────────────────────────
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret
STREAM_APP_ID=your_stream_app_id

# ── MongoDB ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/?appName=Cluster

# ── JWT — BẮT BUỘC đặt giá trị ngẫu nhiên dài ≥ 32 ký tự ─────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_DAI_48_BYTE
JWT_REFRESH_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_DAI_48_BYTE_KHAC

# ── Twilio (SMS) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_messaging_sid

# ── Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Server ────────────────────────────────────────────────────────────
PORT=6036
